        "line_number": 291,
        "text": ""
      },
      {
        "line_number": 292,
        "text": "def add_gate_diagnostics(frame: pd.DataFrame, threshold: float) -> pd.DataFrame:"
      },
      {
        "line_number": 293,
        "text": "    result = frame.copy()"
      },
      {
        "line_number": 294,
        "text": "    result[\"detected\"] = result[\"score\"] > float(threshold)"
      },
      {
        "line_number": 295,
        "text": "    result[\"false_alarm\"] = (result[\"target_present\"] == 0) & result[\"detected\"]"
      },
      {
        "line_number": 296,
        "text": "    result[\"correct_detection\"] = ("
      },
      {
        "line_number": 297,
        "text": "        (result[\"target_present\"] == 1) & result[\"detected\"] & result[\"localization_ok\"]"
      },
      {
        "line_number": 298,
        "text": "    )"
      },
      {
        "line_number": 299,
        "text": "    result[\"dominant_branch\"] = np.where(result[\"gate_h\"] >= result[\"gate_v\"], \"H\", \"V\")"
      },
      {
        "line_number": 300,
        "text": "    result[\"gate_margin\"] = np.abs(result[\"gate_h\"] - result[\"gate_v\"])"
      },
      {
        "line_number": 301,
        "text": "    return result"
      },
      {
        "line_number": 302,
        "text": ""
      },
      {
        "line_number": 303,
        "text": ""
      },
      {
        "line_number": 304,
        "text": "def gate_statistics(frame: pd.DataFrame, split: str) -> pd.DataFrame:"
      },
      {
        "line_number": 305,
        "text": "    masks = {"
      },
      {
        "line_number": 306,
        "text": "        \"all\": np.ones(len(frame), dtype=bool),"
      },
      {
        "line_number": 307,
        "text": "        \"positive\": frame[\"target_present\"].to_numpy(int) == 1,"
      },
      {
        "line_number": 308,
        "text": "        \"background\": frame[\"target_present\"].to_numpy(int) == 0,"
      },
      {
        "line_number": 309,
        "text": "        \"correct_positive\": frame[\"correct_detection\"].to_numpy(bool),"
      },
      {
        "line_number": 310,
        "text": "        \"failed_positive\": (frame[\"target_present\"].to_numpy(int) == 1) & ~frame[\"correct_detection\"].to_numpy(bool),"
      },
      {
        "line_number": 311,
        "text": "        \"false_alarm\": frame[\"false_alarm\"].to_numpy(bool),"
      },
      {
        "line_number": 312,
        "text": "    }"
      },
      {
        "line_number": 313,
        "text": "    rows = []"
      },
      {
        "line_number": 314,
        "text": "    for group, mask in masks.items():"
      },
      {
        "line_number": 315,
        "text": "        part = frame.loc[mask]"
      },
      {
        "line_number": 316,
        "text": "        rows.append({"
      },
      {
        "line_number": 317,
        "text": "            \"split\": split,"
      },
      {
        "line_number": 318,
        "text": "            \"group\": group,"
      },
      {
        "line_number": 319,
        "text": "            \"count\": int(len(part)),"
      },
      {
        "line_number": 320,
        "text": "            \"mean_gate_h\": float(part[\"gate_h\"].mean()) if len(part) else math.nan,"
      }
    ],
    [
      {
        "line_number": 339,
        "text": "    metrics: dict[str, float | int],"
      },
