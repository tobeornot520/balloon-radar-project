      {
        "line_number": 287,
        "text": "    if sample_count == 0:"
      },
      {
        "line_number": 288,
        "text": "        raise RuntimeError(\"评价DataLoader为空\")"
      },
      {
        "line_number": 289,
        "text": "    return pd.DataFrame(rows), {key: value / sample_count for key, value in sums.items()}"
      },
