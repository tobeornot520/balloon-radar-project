        "line_number": 268,
        "text": "                    \"true_range_index\": int(true_r[i]),"
      },
      {
        "line_number": 269,
        "text": "                    \"true_velocity_index\": int(true_v[i]),"
      },
      {
        "line_number": 270,
        "text": "                    \"range_error_gates\": range_error,"
      },
      {
        "line_number": 271,
        "text": "                    \"velocity_error_bins\": velocity_error,"
      },
      {
        "line_number": 272,
        "text": "                    \"localization_ok\": bool(localization_ok),"
      },
      {
        "line_number": 273,
        "text": "                    \"h_aux_score\": float(arrays[\"h_score\"][i]),"
      },
      {
        "line_number": 274,
        "text": "                    \"v_aux_score\": float(arrays[\"v_score\"][i]),"
      }
    ],
    [
      {
        "line_number": 278,
        "text": "                    \"v_pred_velocity_index\": int(arrays[\"v_v\"][i]),"
      },
      {
        "line_number": 279,
        "text": "                    \"gate_h\": float(arrays[\"gates\"][i, 0]),"
      },
      {
        "line_number": 280,
        "text": "                    \"gate_v\": float(arrays[\"gates\"][i, 1]),"
      },
      {
        "line_number": 281,
        "text": "                    \"beam_layer\": int(np.asarray(batch[\"beam_layer\"])[i]),"
      },
      {
        "line_number": 282,
        "text": "                    \"azimuth_deg\": float(np.asarray(batch[\"azimuth_deg\"])[i]),"
      },
      {
        "line_number": 283,
        "text": "                    \"distance_m\": float(np.asarray(batch[\"distance_m\"])[i]),"
      },
      {
        "line_number": 284,
        "text": "                    \"velocity_mps\": float(np.asarray(batch[\"velocity_mps\"])[i]),"
      },
      {
        "line_number": 285,
